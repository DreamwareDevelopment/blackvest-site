---
const steps = [
  { n: "01", t: "Prove it on merit", b: "A structured interview assesses how you actually think and build. It's a gate, not a paywall; you cannot buy your way past it." },
  { n: "02", t: "The system goes to work", b: "It sources roles that fit, tailors every application to the posting, and never fabricates a claim. Quality over volume, always." },
  { n: "03", t: "You approve every send", b: "Nothing leaves without your explicit yes. Appropriate autonomy with human oversight; the exact maturity these roles are screened for." },
];
---
<section class="section how" id="how">
  <div class="wrap">
    <span class="eyebrow reveal">How it works</span>
    <h2 class="how__title reveal">An operator's system, pointed at your search.</h2>
    <ol class="how__grid">
      {steps.map((s) => (
        <li class="how__step reveal">
          <span class="how__n">{s.n}</span>
          <h3>{s.t}</h3>
          <p class="dim">{s.b}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .how__title { font-size: var(--fs-h2); margin-block: var(--s-3) var(--s-8); max-width: 22ch; }
  .how__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-6); }
  @media (max-width: 760px) { .how__grid { grid-template-columns: 1fr; } }
  .how__step { background: var(--bg2); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--s-6); display: flex; flex-direction: column; gap: var(--s-3); }
  .how__n { font-family: var(--mono); font-size: .8rem; color: var(--gold); }
  .how__step h3 { font-size: var(--fs-h3); }
  .how__step p { font-size: var(--fs-small); line-height: var(--lh-snug); }
</style>
