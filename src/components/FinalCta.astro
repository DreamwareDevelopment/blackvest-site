---
import SceneVideo from "./SceneVideo.astro";
import { site } from "../site.config";
---
<section class="section final">
  <SceneVideo
    name="loom"
    scrim="center"
    label="A black vest and bow tie suspended among flowing ribbons of golden light."
  />
  <div class="wrap final__in">
    <span class="eyebrow reveal">Admission</span>
    <h2 class="final__title reveal">The vest is earned.</h2>
    <p class="lede final__sub reveal">Take the assessment. If the system is confident it can place you, you’ll know.</p>
    <p class="reveal" data-d="1"><a class="btn-p" href={site.funnelUrl}>Start your assessment</a></p>
    <p class="micro final__micro reveal" data-d="2">Stage 1 is free</p>
  </div>
</section>
<style>
  /* a brand sign-off, not a second hero: the Loom is the closing mark, sized like
     the sections around it (padding-block, not viewport height) so the gate — the
     thesis section — stays the visual peak of the page */
  .final { display:flex; align-items:center; overflow:hidden; text-align:center; }
  .final__in { position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; gap:var(--s-3); padding-block:var(--s-8); }
  /* centered composition: drop the eyebrow's left rule so the label optically centers */
  .final__in .eyebrow::before { display:none; }
  .final__title { font-size:var(--fs-h2); text-shadow:0 2px 20px rgba(5,5,5,.6); }
  .final__sub { max-width:28rem; }
  .final__micro { margin-top:var(--s-1); }
</style>
