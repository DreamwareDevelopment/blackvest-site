---
/**
 * Full-bleed footage layer. The still IS the poster (frame 0 of the master),
 * shown as the always-on base plate; the looping MP4 (1080p wide / 720p narrow)
 * fades in over it once playing — at every width, phones included. Because the
 * still and the video are the SAME frame at the SAME `object-position`, the
 * fade-in is pixel-aligned: the figure never jumps or reframes, it just comes
 * alive. Reduced-motion, save-data, no-JS, or a user-paused session fall back
 * to the still alone, zero motion. The footage is decorative — `label` carries
 * the meaning for screen readers.
 *
 * `focusX` sets the horizontal object-position of BOTH the still and the video
 * (kept in lockstep — see above). The masters are 16:9; on a portrait phone
 * `object-fit:cover` shows a vertical slice, so a scene whose subject sits
 * off-centre in the landscape frame (the hero figure lives right-of-centre)
 * needs its slice nudged to keep the subject framed. Gate and loom are
 * centre-composed, so they keep the 50% default.
 */
interface Props {
  name: "hero" | "gate" | "loom";
  scrim?: "left" | "center" | "right";
  label: string;
  priority?: boolean;
  focusX?: string;
}
const { name, scrim = "left", label, priority = false, focusX = "50%" } = Astro.props;
---
<div class="scene" data-scene>
  <img
    class="scene__still"
    src={`/media/${name}-poster.jpg`}
    alt=""
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    style={`object-position:${focusX} center`}
  />
  <video
    class="scene__video"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    style={`object-position:${focusX} center`}
    data-desktop={`/media/${name}-1080.mp4`}
    data-narrow={`/media/${name}-720.mp4`}
  ></video>
  <div class={`scene__scrim scene__scrim--${scrim}`} aria-hidden="true"></div>
  <span class="sr-only">{label}</span>
</div>

<script>
  // Astro dedupes this module across SceneVideo instances — it runs once and
  // governs every scene on the page.
  if ("IntersectionObserver" in window) {
    const rm = matchMedia("(prefers-reduced-motion: reduce)");
    const conn = (navigator as any).connection; // nonstandard; feature-detect
    const saveData = !!(conn && conn.saveData);
    const narrowMq = matchMedia("(max-width: 1279px)");
    const visible = new Set<HTMLVideoElement>();
    // Footage plays slowed to 0.75x for a calmer, more luxurious drift (founder pref).
    const PLAYBACK_RATE = 0.75;

    // motion is off only for an OS/UA reduced-motion preference or a data-saver
    // (screen size no longer gates it; phones play the footage too)
    const motionOff = () => rm.matches || saveData;

    // width-reactive: re-decided on every apply(), so resizing across the 1280px
    // boundary picks the right rendition / restores video live
    function apply() {
      const still = rm.matches || saveData;
      document.querySelectorAll<HTMLElement>("[data-scene]").forEach((s) =>
        s.classList.toggle("scene--rm", still)
      );
      visible.forEach((v) => {
        if (motionOff()) { v.pause(); return; }
        if (!v.currentSrc && !v.src) {
          v.src = narrowMq.matches ? v.dataset.narrow! : v.dataset.desktop!;
          v.load();
        }
        v.playbackRate = PLAYBACK_RATE; // reassert after any load() reset
        const p = v.play();
        if (p) p.catch(() => {});
      });
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) visible.add(v);
          else { visible.delete(v); v.pause(); }
        }
        apply();
      },
      { rootMargin: "30% 0px" }
    );

    document.querySelectorAll<HTMLVideoElement>("video.scene__video").forEach((v) => {
      v.defaultPlaybackRate = PLAYBACK_RATE; // the rate the resource loads at
      v.addEventListener("playing", () => v.classList.add("playing"), { once: true });
      io.observe(v);
    });

    // re-decide on viewport / preference change (older Safari uses addListener)
    [narrowMq, rm].forEach((mq) =>
      mq.addEventListener ? mq.addEventListener("change", apply) : (mq as any).addListener(apply)
    );
  }
</script>
