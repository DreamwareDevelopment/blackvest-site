<section class="section wl" id="waitlist">
  <div class="wrap wl__inner">
    <span class="eyebrow reveal">Request an invite</span>
    <h2 class="wl__title reveal">Join the waitlist.</h2>
    <p class="lede prose reveal dim">
      Early access opens to a small first cohort. Drop your email and you'll be
      first to know when interviews open.
    </p>
    <form class="wl__form reveal" id="wl-form" method="POST" action="/api/waitlist">
      <input type="text" name="website" class="wl__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="source" value="apex" />
      <input class="wl__email" type="email" name="email" required placeholder="you@email.com" aria-label="Email address" />
      <button class="btn-p" type="submit">Get early access</button>
    </form>
    <p class="wl__msg" id="wl-msg" role="status" aria-live="polite"></p>
  </div>
</section>
<style>
  .wl__inner { max-width: var(--maxw-prose); }
  .wl__title { font-size: var(--fs-h2); margin-block: var(--s-3) var(--s-4); }
  .wl__form { margin-top: var(--s-6); display: flex; gap: var(--s-2); flex-wrap: wrap; }
  .wl__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .wl__email { flex: 1; min-width: 14rem; background: var(--bg2); border: 1px solid var(--line); border-radius: var(--radius); padding: .85rem 1rem; color: var(--ink); font: inherit; }
  .wl__email::placeholder { color: var(--mute); }
  .wl__msg { margin-top: var(--s-3); font-family: var(--mono); font-size: .8rem; min-height: 1.2em; }
  .wl__msg.ok { color: var(--gold); } .wl__msg.err { color: #e06a6a; }

  @media (max-width: 640px) {
    /* Stack the field over a full-width button instead of cramming them on
       one row (the 14rem min-width forced an ugly wrap before). */
    .wl__form { flex-direction: column; align-items: stretch; }
    .wl__email { min-width: 0; width: 100%; }
    .wl__form .btn-p { width: 100%; }
  }
</style>
<script is:inline>
  (function () {
    var f = document.getElementById("wl-form"), m = document.getElementById("wl-msg");
    if (!f) return;
    f.addEventListener("submit", function (e) {
      e.preventDefault();
      var data = new FormData(f);
      m.className = "wl__msg"; m.textContent = "Adding you...";
      fetch("/api/waitlist", { method: "POST", body: data })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          if (j && j.ok) { m.className = "wl__msg ok"; m.textContent = "You're on the list. We'll be in touch."; f.reset(); }
          else { m.className = "wl__msg err"; m.textContent = "That didn't work. Check the email and try again."; }
        })
        .catch(function () { m.className = "wl__msg err"; m.textContent = "Network error. Try again in a moment."; });
    });
  })();
</script>
